# Copy to .env and fill in. Never commit real values.
# Vercel does not read this file: set the same VITE_* values in Vercel → Settings → Environment Variables.
# Every VITE_* variable is embedded in the public browser bundle.

# Supabase project URL and public anon (publishable) key.
# Never put the service-role key in any VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public address of the app, used for links in confirmation and password-reset emails.
# Recommended: leave empty. Links then use the address the app is open on, so the same
# value works on localhost and Vercel. Both addresses must be allowed in
# Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_SITE_URL=

# Market data transport: "proxy" (recommended for production) or "direct".
#   proxy  -> calls the Supabase Edge Function `coingecko-proxy`; the CoinGecko key stays server-side
#             (set it with: supabase secrets set COINGECKO_API_KEY=... COINGECKO_PLAN=demo)
#   direct -> browser calls api.coingecko.com directly; VITE_COINGECKO_API_KEY (if set) is PUBLIC
VITE_MARKET_DATA_MODE=direct

# Optional CoinGecko Demo API key, used only in "direct" mode. It will be visible in the bundle.
VITE_COINGECKO_API_KEY=

# Only for `npm run db:migrate` (never used by the app, never sent to the browser).
# Do not add it to Vercel.
# Your database password, as-is (Supabase → Project Settings → Database).
SUPABASE_DB_PASSWORD=
# Optional: only if your network has no IPv6. Supabase → Connect → Session pooler → host.
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
